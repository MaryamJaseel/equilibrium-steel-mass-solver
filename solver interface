    # ==========================================================
    # RUN SENSITIVITY ANALYSIS
    # ==========================================================

    def run_sensitivity(self):

        try:

            O_min = float(
                self.o_min_entry.get()
            )

            O_max = float(
                self.o_max_entry.get()
            )

            points = int(
                self.points_entry.get()
            )


            if points < 2:

                raise ValueError(
                    "Use at least 2 points."
                )


            if O_min < 0 or O_max <= O_min:

                raise ValueError(
                    "Invalid oxygen range."
                )


            # Read current metal conditions

            mass = float(
                self.mass_entry.get()
            )

            Si = float(
                self.si_entry.get()
            )

            Mn = float(
                self.mn_entry.get()
            )

            phi = float(
                self.phi_entry.get()
            )

            tolerance = float(
                self.tol_entry.get()
            )


            # Oxygen values

            O_values = np.linspace(
                O_min,
                O_max,
                points
            )


            # Results

            slag_masses = []

            equilibrium_Si = []

            equilibrium_Mn = []

            equilibrium_O = []


            for O_initial in O_values:


                result = solve_equilibrium(

                    initial_mass=mass,

                    Si_initial=Si,

                    Mn_initial=Mn,

                    O_initial=O_initial,

                    phi=phi,

                    tolerance=tolerance

                )


                slag_masses.append(
                    result["slag_mass"]
                )

                equilibrium_Si.append(
                    result["Si"]
                )

                equilibrium_Mn.append(
                    result["Mn"]
                )

                equilibrium_O.append(
                    result["O"]
                )


            # --------------------------------------------------
            # Plot
            # --------------------------------------------------

            self.sens_figure.clear()


            ax = self.sens_figure.add_subplot(
                111
            )


            ax.plot(
                O_values,
                slag_masses,
                "o-"
            )


            ax.set_xlabel(
                "Initial Oxygen (wt%)"
            )

            ax.set_ylabel(
                "Equilibrium Slag Mass (g)"
            )

            ax.set_title(
                "Sensitivity of Slag Formation to Initial Oxygen"
            )

            ax.grid(True)


            self.sens_figure.tight_layout()


            self.sens_canvas.draw()


            # --------------------------------------------------
            # Save data internally
            # --------------------------------------------------

            self.sensitivity_data = {

                "O_initial": O_values,

                "slag_mass": np.array(
                    slag_masses
                ),

                "Si_equilibrium": np.array(
                    equilibrium_Si
                ),

                "Mn_equilibrium": np.array(
                    equilibrium_Mn
                ),

                "O_equilibrium": np.array(
                    equilibrium_O
                )

            }


        except Exception as e:

            messagebox.showerror(
                "Sensitivity Analysis Error",
                str(e)
            )


